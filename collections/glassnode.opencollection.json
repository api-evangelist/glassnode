              {
                "name": "i",
                "value": "",
                "type": "query"
              },
              {
                "name": "s",
                "value": "",
                "type": "query",
                "description": "Unix timestamp (inclusive lower bound)"
              },
              {
                "name": "u",
                "value": "",
                "type": "query",
                "description": "Unix timestamp (inclusive upper bound)"
              },
              {
                "name": "f",
                "value": "",
                "type": "query"
