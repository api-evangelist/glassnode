      {
        "name": "fetch_metric",
        "description": "Fetch data for a single asset from Glassnode API.\n\nUse this tool when you need to:\n- Fetch data for ONE specific asset\n- Get detailed data for a single cryptocurrency\n\nIMPORTANT: If you need data for MULTIPLE assets, use fetch_bulk_metrics instead!\nThis tool should only be used for single-asset requests to avoid unnecessary API calls.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "The full API endpoint path including /v1/metrics prefix (e.g., '/v1/metrics/market/price_usd_close')"
            },
            "params": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Query parameters as key-value pairs (e.g. {'a': 'BTC', 's': '1746662400'})."
            }
          },
          "required": [
            "endpoint"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "_meta": {
          "version": "1.0.0",
          "category": "data-fetching",
          "requiresAuth": false,
          "rateLimit": "tier-based",
          "examples": [
            {
              "description": "Fetch Bitcoin price",
              "params": {
                "endpoint": "/v1/metrics/market/price_usd_close",
                "params": {
                  "a": "BTC"
                }
              }
            },
            {
              "description": "Fetch Ethereum 24h volume",
              "params": {
                "endpoint": "/v1/metrics/market/volume_sum",
                "params": {
                  "a": "ETH",
                  "i": "24h"
                }
              }
            }
          ]
        }
      },
      {
        "name": "fetch_bulk_metrics",
        "description": "Fetch data for multiple assets efficiently using Glassnode's bulk endpoint.\n\nPREFERRED: Use this tool when you need to:\n- Fetch the same metric for MULTIPLE assets (2 or more)\n- Compare data across different cryptocurrencies\n- Get comprehensive market data for several assets\n- Avoid making multiple individual API calls\n\nEFFICIENCY TIP: Always batch multiple asset requests into a single call\ninstead of making separate fetch_metric calls for each asset.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "The full metric endpoint path including /v1/metrics prefix (e.g., '/v1/metrics/market/price_usd_close')"
            },
            "assets": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of asset symbols (e.g., ['BTC', 'ETH', 'SOL']) for the metric to be fetched. Include ALL assets you need data for in a single call to maximize efficiency."
            },
            "params": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Additional query parameters as key-value pairs (e.g. {'i': '24h', 's': '1746662400'})."
            }
          },
          "required": [
            "endpoint",
            "assets"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "_meta": {
          "version": "1.0.0",
          "category": "data-fetching",
          "requiresAuth": false,
          "rateLimit": "tier-based",
          "bulkOperation": true,
          "examples": [
            {
              "description": "Fetch prices for multiple assets efficiently",
              "params": {
